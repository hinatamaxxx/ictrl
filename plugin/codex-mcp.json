{
  "mcpServers": {
    "utsushite": {
      "cwd": ".",
      "command": "cmd",
      "args": [
        "/c",
        "plugin\\utsushite.cmd",
        "mcp"
      ],
      "env_vars": [
        "PATH",
        "PATHEXT",
        "SYSTEMROOT",
        "WINDIR",
        "COMSPEC",
        "TEMP",
        "TMP",
        "USERPROFILE",
        "USERNAME",
        "APPDATA",
        "LOCALAPPDATA",
        "PROGRAMDATA",
        "PROGRAMFILES"
      ],
      "startup_timeout_sec": 120
    }
  }
}
